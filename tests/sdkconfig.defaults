# Test application configuration.
#
# Deliberately mirrors the gateway's flash layout. The default single-app,
# 2MB layout would rewrite the partition table with a different geometry, and
# flashing the tests would then move NVS, zb_storage and the LittleFS converter
# database out from under the gateway. Sharing partitions.csv means the test
# binary simply occupies ota_0 and everything else on the chip is left alone.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"

# device_registry allocates its device array, state table and hash table from
# PSRAM (MEM_CAP_PSRAM). Without PSRAM the tests would exercise a different
# allocation path than production does.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Keep the C standard identical to the gateway build.
CONFIG_LIBC_PICOLIBC_NEWLIB_COMPATIBILITY=y
